# ─── Sentry env vars ───
# Copy to .env.local and fill in real values. Never commit .env.local.

# Public site URL (used for absolute URLs, metadata, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-only (NEVER expose to the browser) ──

# Google AI Studio — Gemini 2.5 Flash
# Get it at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Supabase (conversations + leads + rate limit)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Notion (Now page CMS — https://www.notion.so/my-integrations)
NOTION_API_KEY=
NOTION_NOW_DATABASE_ID=

# Optional: lead notification webhook (Slack, Discord, Telegram, Zapier)
LEAD_NOTIFY_WEBHOOK=

# Gmail SMTP (agent email notifications — free)
# Go to Google Account → Security → App Passwords → Create for "Mail"
SMTP_USER=
SMTP_PASS=

# ── Consulting funnel (/book + /admin/bookings) ──

# Password for the admin panel at /admin/bookings
ADMIN_PASSWORD=

# Google Calendar (real availability on /book + auto Meet links on approval)
# OAuth2 refresh-token flow — create an OAuth client (Desktop) in Google Cloud,
# set the consent screen to "In production" (Testing-mode refresh tokens die
# after 7 days), then mint a refresh token with the calendar scope.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Signs one-click approve/decline links in booking emails (falls back to ADMIN_PASSWORD)
BOOKING_ACTION_SECRET=

# Protects /api/cron/resources — Vercel sends it automatically when set
CRON_SECRET=

# Optional: where new-booking alerts are sent (defaults to adelusidankunle@gmail.com)
NOTIFICATION_EMAIL=

# Google Sheets lead sync (optional — bookings still save to Supabase without it)
# Paste the FULL service account JSON on one line; share the sheet with its
# client_email as Editor. GOOGLE_SHEET_ID is the long id in the sheet URL.
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEET_ID=
# Tab name to append to (defaults to Sheet1)
GOOGLE_SHEET_TAB=
